{
  "$schema": "https://openapi.vercel.sh/schema.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api" },
    { "source": "/d/(.*)", "destination": "/api" },
    { "source": "/((?!assets/|api/|d/).*)", "destination": "/index.html" }
  ],
  "functions": {
    "api/index.js": {
      "maxDuration": 60,
      "includeFiles": "dist/ssr/**"
    }
  }
}
