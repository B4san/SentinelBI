# Server-side keys. Never commit real secrets.
# The Settings UI can also store a key in the browser (localStorage only).

# Default provider when the UI does not specify one: gemini | openrouter | openai | groq | together | deepseek | mistral | ollama | lmstudio | custom
AI_PROVIDER=gemini
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Provider-specific fallbacks
GEMINI_API_KEY=
OPENROUTER_API_KEY=
# When AI_PROVIDER=openrouter and no model is set, the default is openrouter/free.
# OPENROUTER_MODEL overrides both the UI model and AI_MODEL for OpenRouter.
OPENROUTER_MODEL=
OPENAI_API_KEY=
GROQ_API_KEY=
TOGETHER_API_KEY=
DEEPSEEK_API_KEY=
MISTRAL_API_KEY=

# Optional local endpoints (OpenAI-compatible)
# Ollama: http://127.0.0.1:11434/v1
# LM Studio: http://127.0.0.1:1234/v1

# Generation deadline in milliseconds. On Vercel this defaults to 50000.
AI_DEADLINE_MS=

# Optional durable dashboard store (otherwise in-memory / local fs)
BLOB_READ_WRITE_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

APP_URL=http://localhost:3000
PORT=3000
